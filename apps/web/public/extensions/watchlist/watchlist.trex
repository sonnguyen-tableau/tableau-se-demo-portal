<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.namabank.aiwatchlist" extension-version="0.1.0">
    <default-locale>vi-VN</default-locale>
    <name resource-id="name"/>
    <description>AI Watchlist — danh sách khách hàng rủi ro cao với giải thích AI và drill-down.</description>
    <author name="Nam A Bank Analytics" email="analytics@namabank.com.vn" organization="Nam A Bank" website="https://www.namabank.com.vn"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://tableau-portal-mu.vercel.app/extensions/watchlist/watchlist.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsMAAA7DAcdvqGQAAAAaSURBVDhPYxgFo2AUjIJRMApGwSgYBSMAAAeuAAF6i8kUAAAAAElFTkSuQmCC</icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="vi-VN">AI Watchlist Nam A Bank</text>
      <text locale="en-US">Nam A Bank AI Watchlist</text>
    </resource>
  </resources>
</manifest>
