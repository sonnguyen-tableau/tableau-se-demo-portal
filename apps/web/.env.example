# Copy to .env.local and fill in with YOUR OWN values. Never commit real values.
# One-time Tableau Cloud setup (Connected App, PAT, user attributes, allowlist):
#   docs/runbooks/tableau-cloud-setup.md
# First-run walkthrough: docs/onboarding/se-quickstart.md

# ────────────────────────────────────────────────────────────
# NextAuth
# ────────────────────────────────────────────────────────────
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Development credentials provider (dev only — real IdP in production).
# One entry per demo login. `groups:["internal-employees"]` = internal admin
# (sees the admin hub + all portals); a plain tenantId = a scoped tenant user.
DEV_USERS_JSON='[{"email":"admin@portal.com","password":"dev","tenantId":"internal","tenantName":"Portal Admin","region":"NA","groups":["internal-employees"]},{"email":"demo@acme.com","password":"dev","tenantId":"acme","tenantName":"Acme Corp","region":"NA","groups":[]}]'

# ────────────────────────────────────────────────────────────
# Tableau Cloud (YOUR site)
# ────────────────────────────────────────────────────────────
TABLEAU_SITE="https://10ax.online.tableau.com/#/site/<your-site>"
TABLEAU_SITE_NAME="<your-site-content-url>"
TABLEAU_SITE_VERSION="2026.1"

# Origin used to load the Tableau embedding JS from your pod's CDN. Optional —
# it is normally derived from the embed src URL; set it only as a safety net.
NEXT_PUBLIC_TABLEAU_HOST="https://10ax.online.tableau.com"

# Connected App (Direct Trust) — see docs/runbooks/tableau-cloud-setup.md
TABLEAU_CONNECTED_APP_CLIENT_ID="<uuid>"
TABLEAU_CONNECTED_APP_SECRET_ID="<uuid>"
TABLEAU_CONNECTED_APP_SECRET_VALUE="<secret-shown-once>"

# Real user on YOUR Tableau site, used as the embed JWT `sub` for all demo
# users (demo accounts don't exist on the Tableau site). Required for embeds.
TABLEAU_EMBED_USER="you@yourcompany.com"

# Only "true" if your Connected App has On-Demand Access enabled. Default off.
TABLEAU_ODA="false"

# Service-account PAT (used by the MCP sidecar and the AI agent)
TABLEAU_PAT_NAME="tableau-ai-portal-svc"
TABLEAU_PAT_SECRET="<shown-once>"

# ────────────────────────────────────────────────────────────
# Anthropic
# ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ────────────────────────────────────────────────────────────
# Sidecars
# ────────────────────────────────────────────────────────────
TABLEAU_MCP_URL="http://localhost:8081"
FACTORY_URL="http://localhost:8000"

# Shared bearer secret between the factory sidecar and the portal's
# /api/admin/provision/* callback routes. openssl rand -hex 32
FACTORY_PROVISION_SECRET=""

# ────────────────────────────────────────────────────────────
# Multi-site admin UI (/admin/sites) — optional
# ────────────────────────────────────────────────────────────
# AES-256-GCM key (64 hex chars) that encrypts per-site Connected App secrets
# at rest in KV. Required only if you use the multi-site admin UI in prod.
# openssl rand -hex 32
SITE_CONFIG_ENCRYPTION_KEY=""

# ────────────────────────────────────────────────────────────
# Storage (Vercel KV / Upstash Redis) — optional
# ────────────────────────────────────────────────────────────
# When unset, the portal falls back to bundled JSON in apps/web/data/*.
# Set both to persist tenants/themes/users/history across restarts.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ────────────────────────────────────────────────────────────
# Localization
# ────────────────────────────────────────────────────────────
# Default UI language. "en" (default) or "vi". Add more by extending
# LOCALES + CATALOG in apps/web/lib/i18n-shared.ts.
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# ────────────────────────────────────────────────────────────
# Cost guardrails
# ────────────────────────────────────────────────────────────
IMPRESSION_DAILY_CAP_PER_TENANT="2000"

# ────────────────────────────────────────────────────────────
# Misc
# ────────────────────────────────────────────────────────────
PORTAL_ENV="dev"
