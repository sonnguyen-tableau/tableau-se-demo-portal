# Copy to .env.local and fill in. Never commit real values.

# ────────────────────────────────────────────────────────────
# NextAuth
# ────────────────────────────────────────────────────────────
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Development credentials provider (Phase 1 only — real IdP in later phase)
DEV_USERS_JSON='[{"email":"alice@acme.com","password":"dev","tenantId":"tenant-acme","tenantName":"Acme Bikes","region":"NA","groups":[]},{"email":"bob@globex.com","password":"dev","tenantId":"tenant-globex","tenantName":"Globex Logistics","region":"EMEA","groups":[]},{"email":"admin@portal.com","password":"dev","tenantId":"internal","tenantName":"Portal Admin","region":"NA","groups":["internal-employees"]}]'

# ────────────────────────────────────────────────────────────
# Tableau Cloud
# ────────────────────────────────────────────────────────────
TABLEAU_SITE="https://10ax.online.tableau.com/#/site/<your-site>"
TABLEAU_SITE_NAME="<your-site-content-url>"
TABLEAU_SITE_VERSION="2026.1"

# Connected App (Direct Trust) — see docs/runbooks/tableau-cloud-setup.md
TABLEAU_CONNECTED_APP_CLIENT_ID="<uuid>"
TABLEAU_CONNECTED_APP_SECRET_ID="<uuid>"
TABLEAU_CONNECTED_APP_SECRET_VALUE="<secret-shown-once>"

# Service-account PAT (used by MCP sidecar in Phase 3+)
TABLEAU_PAT_NAME="tableau-ai-portal-svc"
TABLEAU_PAT_SECRET="<shown-once>"

# ────────────────────────────────────────────────────────────
# Anthropic (Phase 3+)
# ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ────────────────────────────────────────────────────────────
# MCP sidecar (Phase 3+)
# ────────────────────────────────────────────────────────────
TABLEAU_MCP_URL="http://localhost:8081"

# ────────────────────────────────────────────────────────────
# Factory sidecar (Phase 7+)
# ────────────────────────────────────────────────────────────
FACTORY_URL="http://localhost:8000"

# ────────────────────────────────────────────────────────────
# Cost guardrails (Phase 6+)
# ────────────────────────────────────────────────────────────
IMPRESSION_DAILY_CAP_PER_TENANT="2000"

# ────────────────────────────────────────────────────────────
# Misc
# ────────────────────────────────────────────────────────────
PORTAL_ENV="dev"
