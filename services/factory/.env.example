# Copy to services/factory/.env and fill in with YOUR OWN values.
# Never commit real secrets. Loaded by app/config.py (pydantic-settings).
#
# All Tableau/Anthropic values are OPTIONAL for local tests: stages that need a
# missing credential skip gracefully (publish/pulse are skipped without Tableau
# creds; profile/brand are skipped without an Anthropic key).

PORTAL_ENV="dev"

# Where generated .hyper/.tdsx artifacts are written.
FACTORY_DATA_DIR="/tmp/factory"

# ── Anthropic (profile / schema / brand stages) ─────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# ── Tableau Cloud (default publish target) ──────────────────────────────────
# Base origin, NO "#/site/..." path — TSC routes via the site content-url below.
TABLEAU_SITE_URL="https://10ax.online.tableau.com"
TABLEAU_SITE_NAME="<your-site-content-url>"
TABLEAU_PAT_NAME="tableau-ai-portal-svc"
TABLEAU_PAT_SECRET="<shown-once>"
#
# NOTE: a factory run can override this default site per-request (the portal
# forwards the resolved per-site PAT). This .env is the fallback when no
# per-run target is supplied. See docs/onboarding/new-demo-request.md.

# Rows per generated tenant (10k–1M).
TARGET_ROW_COUNT="200000"

# Shared bearer secret for the provision callback into the portal.
# Must match the portal's FACTORY_PROVISION_SECRET. openssl rand -hex 32
FACTORY_PROVISION_SECRET=""
