        <calculation class='tableau' formula='SUM([DealValueVnd])' />
      </column>
      <column caption='Tổng tiền thu' datatype='integer' default-format='n#,##0,,,&quot;tỷ&quot;' name='[Calculation_0090010000000002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AmountCollectedVnd])' />
      </column>
      <column caption='Công nợ phải thu' datatype='integer' default-format='n#,##0,,,&quot;tỷ&quot;' name='[Calculation_0090010000000003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AmountDueVnd]) - SUM([AmountCollectedVnd])' />
      </column>
      <column caption='Sản lượng (căn)' datatype='integer' default-format='n#,##0' name='[Calculation_0090010000000004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([SaleId])' />
      </column>
      <column caption='Lợi nhuận' datatype='integer' default-format='n#,##0,,,&quot;tỷ&quot;' name='[Calculation_0090010000000005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ProfitVnd])' />
      </column>
      <column caption='Pct HT SL' datatype='real' default-format='p0%' name='[Calculation_009001100000011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([UnitsSold (MonthlyFinancial)]) / SUM([UnitsSoldKpi])' />
      </column>
      <column caption='Đạt SL' datatype='real' default-format='p0%' name='[Calculation_009001100000012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([Calculation_009001100000011],1)' />
      </column>
      <column caption='Còn lại - SL' datatype='real' name='[Calculation_009001100000013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_009001100000012]' />
      </column>
      <column caption='Pct HT Rev' datatype='real' default-format='p0%' name='[Calculation_009001100000021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([RevenueVnd]) / SUM([RevenueKpiVnd])' />
      </column>
      <column caption='Đạt Rev' datatype='real' default-format='p0%' name='[Calculation_009001100000022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([Calculation_009001100000021],1)' />
      </column>
      <column caption='Còn lại - Rev' datatype='real' name='[Calculation_009001100000023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_009001100000022]' />
      </column>
      <column caption='Pct HT Cash' datatype='real' default-format='p0%' name='[Calculation_009001100000031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CashCollectedVnd]) / SUM([CashCollectedKpiVnd])' />
      </column>
      <column caption='Đạt Cash' datatype='real' default-format='p0%' name='[Calculation_009001100000032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([Calculation_009001100000031],1)' />
      </column>
      <column caption='Còn lại - Cash' datatype='real' name='[Calculation_009001100000033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_009001100000032]' />
      </column>
      <column caption='min0' datatype='integer' name='[Calculation_00900119000000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(0)' />
      </column>
