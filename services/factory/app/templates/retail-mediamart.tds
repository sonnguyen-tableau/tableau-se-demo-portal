<?xml version='1.0' encoding='utf-8' ?>
<!--
  Object Model template for retail-mediamart (Tableau 2020.2+).
  Exposes 7 tables (OrderLines fact + 6 dim/inventory) to Tableau Cloud
  as a proper multi-table relationships canvas instead of flat 'Migrated Data'.
  Factory rewrites __FACTORY_DATASOURCE__ to the in-zip path at packaging time.
-->
<datasource formatted-name='federated.mediamart' inline='true' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <ObjectModelEncapsulateLegacy />
    <ObjectModelExtractV2 />
    <_.fcp.ObjectModelSharedDimensions.true...ObjectModelSharedDimensions />
    <ObjectModelTableType />
    <SchemaViewerObjectModel />
  </document-format-change-manifest>
  <connection class='federated'>
    <named-connections>
      <named-connection caption='retail-mediamart' name='hyper.mediamart'>
        <connection authentication='auth-none' author-locale='en_US' class='hyper' dbname='__FACTORY_DATASOURCE__' default-settings='yes' server='' sslmode='' username='tableau_internal_user' />
      </named-connection>
    </named-connections>
    <relation type='collection'>
      <relation connection='hyper.mediamart' name='OrderLines' table='[Extract].[OrderLines]' type='table' />
      <relation connection='hyper.mediamart' name='Orders' table='[Extract].[Orders]' type='table' />
      <_.fcp.ObjectModelSharedDimensions.true...relation connection='hyper.mediamart' name='Customers' table='[Extract].[Customers]' type='table' />
      <_.fcp.ObjectModelSharedDimensions.true...relation connection='hyper.mediamart' name='Stores' table='[Extract].[Stores]' type='table' />
      <_.fcp.ObjectModelSharedDimensions.true...relation connection='hyper.mediamart' name='Channels' table='[Extract].[Channels]' type='table' />
      <_.fcp.ObjectModelSharedDimensions.true...relation connection='hyper.mediamart' name='Products' table='[Extract].[Products]' type='table' />
      <_.fcp.ObjectModelSharedDimensions.true...relation connection='hyper.mediamart' name='Inventory' table='[Extract].[Inventory]' type='table' />
    </relation>
    <cols>
